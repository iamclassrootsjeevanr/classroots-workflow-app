# Copy to .env and fill in. Never commit .env.

# Postgres. Locally: `npm run db:start` (embedded Postgres, data in .pgdata) uses this URL as-is.
DATABASE_URL=postgresql://user:password@localhost:5432/classroots_work
# Hosted (Railway, Neon, ...): add ?connection_limit=10&pool_timeout=20 to the URL.

# Auth.js – generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google SSO (optional; magic link works without it)
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email for sign-in links and invites (SMTP URL). Google Workspace mailbox with an app password:
#   smtps://no-reply%40yourdomain.com:APP_PASSWORD@smtp.gmail.com:465   (or a Resend/SendGrid SMTP URL)
# Empty in dev → mails are printed in the server log.
EMAIL_SERVER=
EMAIL_FROM=Classroots Work <no-reply@classroots.local>

# Comma-separated emails that are admins; comma-separated domains allowed to sign in without an invite.
ADMIN_EMAILS=you@example.com
ALLOWED_DOMAINS=

APP_TIMEZONE=Asia/Kolkata

# Google Sheet two-way sync (apps-script/Code.gs deployed as a web app)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Same value as the SYNC_TOKEN script property in Apps Script
SYNC_TOKEN=

# Protects /api/cron/run (scheduler / Vercel cron send it as a Bearer token)
CRON_SECRET=

# Password for demo sign-ins created by `npm run demo:users` (local use only; min 10 chars, letters + numbers)
DEMO_PASSWORD=
