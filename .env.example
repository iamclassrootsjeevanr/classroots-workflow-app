# Copy to .env and fill in. Never commit .env.

# Postgres. Locally: `npm run db:start` (embedded Postgres, data in .pgdata) uses this URL as-is.
DATABASE_URL=postgresql://user:password@localhost:5432/classroots_work
# Hosted (Railway, Neon, ...): add ?connection_limit=10&pool_timeout=20 to the URL.

# The hosted database as seen from this machine (Render/Railway External URL + ?sslmode=require).
# Used by db:pull, db:push, db:deploy:remote, db:studio:remote. Empty = those commands stop.
REMOTE_DATABASE_URL=

# Auth.js – generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Sign-in (docs/NEXT-STEPS.md § 7). Only people added in People & access can sign in.
# Office email domains: these people use "Sign in with Google"; everyone else email + a password the admin sets.
OFFICE_DOMAINS=classrootsedu.com
# Comma-separated emails that are always admins (lets the first admin in).
ADMIN_EMAILS=you@example.com

# Google sign-in: Google Cloud Console → OAuth client (Web application), consent screen "Internal"
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email for invites and "Forgot password?" links (SMTP URL). Google Workspace mailbox with an app password:
#   smtps://you%40yourdomain.com:APP_PASSWORD@smtp.gmail.com:465   (or a Resend/SendGrid SMTP URL)
# Empty → these mails are printed in the server log.
EMAIL_SERVER=
EMAIL_FROM=Classroots Work <no-reply@classroots.local>

APP_TIMEZONE=Asia/Kolkata

# Google Sheet sync (apps-script/Code.gs deployed as a web app)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Same value as the SYNC_TOKEN script property in Apps Script
SYNC_TOKEN=

# Protects /api/cron/run (scheduler / Vercel cron send it as a Bearer token)
CRON_SECRET=

# Key for the journey relay (Claude): Bearer token for /api/relay. It can only read journeys and set their Creation stage.
# Generate with: openssl rand -base64 32. Empty → the relay API is off.
RELAY_KEY=

# Password for demo sign-ins created by `npm run demo:users` (local use only; min 10 chars, letters + numbers)
DEMO_PASSWORD=
