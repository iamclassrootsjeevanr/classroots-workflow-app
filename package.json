{
  "name": "classroots-work-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "db:start": "node scripts/local-db.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "import:xlsx": "tsx --env-file=.env scripts/import-xlsx.ts",
    "sync:run": "tsx --env-file=.env scripts/run-jobs.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "user:password": "tsx --env-file=.env scripts/set-password.ts",
    "demo:users": "tsx --env-file=.env scripts/demo-users.ts",
    "import:apk": "tsx --env-file=.env scripts/import-apk-xlsx.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.16.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.65.0",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.29",
    "nodemailer": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
